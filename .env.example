# ── Server ────────────────────────────────────────────────────────────────
PORT=8765
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text           # text | json (json recommended for production)

# ── Optional API key guard (leave blank to disable) ───────────────────────
API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated origins, or * to allow all (not recommended for production)
CORS_ORIGINS=*

# ── Data paths ────────────────────────────────────────────────────────────
DATA_ROOT=/app            # Root directory for mutable data
SIGNALS_PATH=/app/signals.json
FOCUS_PATH=/app/cache/focus.json

# ── LLM focus ranker (optional — falls back to random shuffle if absent) ──
LLM_BIN=ollama
LLM_MODEL=codellama:13b

# ── Distributed Replit LLM inference (alternative to local ollama) ───────
# Set LLM_BIN=scripts/llm_replit_proxy.py and list Replit-hosted Ollama
# node URLs below. See docs/REPLIT_DEPLOYMENT.md.
# LLM_REPLIT_ENDPOINTS=https://node-a.username.repl.co,https://node-b.username.repl.co

# ── Vercel / frontend ─────────────────────────────────────────────────────
# Set this when the static dashboard is served from a different origin
# than the FastAPI backend. The frontend reads window.BACKEND_URL.
# BACKEND_URL=https://your-backend.fly.dev
